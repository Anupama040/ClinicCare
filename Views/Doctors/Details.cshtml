@model ClinicManagement.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<h1>Doctor Details</h1>

<div class="card">
    <div class="card-body">
        <h4>
            Dr. @Model.FirstName @Model.LastName
        </h4>

        <dl class="row">
            <dt class="col-sm-3">Specialization</dt>
            <dd class="col-sm-9">
                @Model.Specialization
            </dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">
                @Model.Email
            </dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">
                @Model.Phone
            </dd>

            <dt class="col-sm-3">Consultation Fee</dt>
            <dd class="col-sm-9">
                @Model.ConsultationFee.ToString("C")
            </dd>

            <dt class="col-sm-3">Available</dt>
            <dd class="col-sm-9">
                @(Model.IsAvailable ? "Yes" : "No")
            </dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">
                @Model.CreatedAt.ToLocalTime()
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Doctors
    </a>
</div>