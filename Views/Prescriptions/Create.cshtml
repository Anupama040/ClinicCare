@model ClinicManagement.ViewModels.PrescriptionViewModel

@{
    ViewData["Title"] = "Create Prescription";
}

<h1>Create Prescription</h1>

<div class="card mb-4">
    <div class="card-body">
        <h4>Appointment information</h4>

        <dl class="row">
            <dt class="col-sm-3">Patient</dt>
            <dd class="col-sm-9">
                @Model.PatientName
            </dd>

            <dt class="col-sm-3">Doctor</dt>
            <dd class="col-sm-9">
                @Model.DoctorName
            </dd>

            <dt class="col-sm-3">Appointment date</dt>
            <dd class="col-sm-9">
                @Model.AppointmentDate.ToString(
                    "dd-MM-yyyy hh:mm tt")
            </dd>
        </dl>
    </div>
</div>

<form asp-controller="Prescriptions"
      asp-action="Create"
      method="post">

    <input type="hidden"
           asp-for="AppointmentId" />

    <input type="hidden"
           asp-for="PatientId" />

    <input type="hidden"
           asp-for="DoctorId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="Diagnosis"
               class="form-label">
        </label>

        <textarea asp-for="Diagnosis"
                  class="form-control"
                  rows="4">
        </textarea>

        <span asp-validation-for="Diagnosis"
              class="text-danger">
        </span>
    </div>

    <h4>Medicines</h4>

    <div id="medicineRows">
        @for (var index = 0;
              index < Model.Items.Count;
              index++)
        {
            <div class="medicine-row border rounded p-3 mb-3">
                <h5>
                    Medicine @(index + 1)
                </h5>

                <div class="mb-3">
                    <label asp-for="Items[index].MedicineName"
                           class="form-label">
                    </label>

                    <input asp-for="Items[index].MedicineName"
                           class="form-control" />

                    <span asp-validation-for="Items[index].MedicineName"
                          class="text-danger">
                    </span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Items[index].Dosage"
                               class="form-label">
                        </label>

                        <input asp-for="Items[index].Dosage"
                               class="form-control"
                               placeholder="Example: 500 mg" />

                        <span asp-validation-for="Items[index].Dosage"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Items[index].Frequency"
                               class="form-label">
                        </label>

                        <input asp-for="Items[index].Frequency"
                               class="form-control"
                               placeholder="Example: Twice daily" />

                        <span asp-validation-for="Items[index].Frequency"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Items[index].Duration"
                               class="form-label">
                        </label>

                        <input asp-for="Items[index].Duration"
                               class="form-control"
                               placeholder="Example: 5 days" />

                        <span asp-validation-for="Items[index].Duration"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Items[index].Instructions"
                           class="form-label">
                    </label>

                    <textarea asp-for="Items[index].Instructions"
                              class="form-control"
                              rows="2"
                              placeholder="Example: Take after food">
                    </textarea>

                    <span asp-validation-for="Items[index].Instructions"
                          class="text-danger">
                    </span>
                </div>

                @if (index > 0)
                {
                    <button type="button"
                            class="btn btn-outline-danger remove-medicine">
                        Remove Medicine
                    </button>
                }
            </div>
        }
    </div>

    <button type="button"
            id="addMedicine"
            class="btn btn-outline-primary mb-3">
        Add Another Medicine
    </button>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Save Prescription
    </button>

    <a asp-controller="Appointments"
       asp-action="Details"
       asp-route-id="@Model.AppointmentId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const medicineRows =
                document.getElementById("medicineRows");

            const addMedicineButton =
                document.getElementById("addMedicine");

            function createMedicineRow(index) {
                const row =
                    document.createElement("div");

                row.className =
                    "medicine-row border rounded p-3 mb-3";

                row.innerHTML = `
                    <h5>Medicine ${index + 1}</h5>

                    <div class="mb-3">
                        <label class="form-label">
                            Medicine name
                        </label>

                        <input name="Items[${index}].MedicineName"
                               class="form-control"
                               required />
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Dosage
                            </label>

                            <input name="Items[${index}].Dosage"
                                   class="form-control"
                                   placeholder="Example: 500 mg"
                                   required />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Frequency
                            </label>

                            <input name="Items[${index}].Frequency"
                                   class="form-control"
                                   placeholder="Example: Twice daily"
                                   required />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Duration
                            </label>

                            <input name="Items[${index}].Duration"
                                   class="form-control"
                                   placeholder="Example: 5 days"
                                   required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Instructions
                        </label>

                        <textarea name="Items[${index}].Instructions"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Example: Take after food">
                        </textarea>
                    </div>

                    <button type="button"
                            class="btn btn-outline-danger remove-medicine">
                        Remove Medicine
                    </button>
                `;

                return row;
            }

            function refreshRemoveButtons() {
                const rows =
                    medicineRows.querySelectorAll(
                        ".medicine-row");

                rows.forEach(function (row, index) {
                    const removeButton =
                        row.querySelector(
                            ".remove-medicine");

                    if (removeButton) {
                        removeButton.style.display =
                            rows.length === 1
                                ? "none"
                                : "inline-block";
                    }
                });
            }

            addMedicineButton.addEventListener(
                "click",
                function () {
                    const currentCount =
                        medicineRows.querySelectorAll(
                            ".medicine-row").length;

                    const newRow =
                        createMedicineRow(currentCount);

                    medicineRows.appendChild(newRow);

                    refreshRemoveButtons();
                });

            medicineRows.addEventListener(
                "click",
                function (event) {
                    if (!event.target.classList.contains(
                        "remove-medicine"))
                    {
                        return;
                    }

                    event.target
                        .closest(".medicine-row")
                        .remove();

                    refreshRemoveButtons();
                });

            refreshRemoveButtons();
        });
    </script>
}