@model ClinicManagement.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
}

<h1>Prescription Details</h1>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Patient</dt>
            <dd class="col-sm-9">
                @Model.Patient.FirstName
                @Model.Patient.LastName
            </dd>

            <dt class="col-sm-3">Doctor</dt>
            <dd class="col-sm-9">
                Dr. @Model.Doctor.FirstName
                @Model.Doctor.LastName
            </dd>

            <dt class="col-sm-3">Appointment date</dt>
            <dd class="col-sm-9">
                @Model.Appointment.AppointmentDate.ToString(
                    "dd-MM-yyyy hh:mm tt")
            </dd>

            <dt class="col-sm-3">Diagnosis</dt>
            <dd class="col-sm-9">
                @(Model.Diagnosis ?? "Not provided")
            </dd>

            <dt class="col-sm-3">Created on</dt>
            <dd class="col-sm-9">
                @Model.CreatedAt.ToLocalTime()
            </dd>
        </dl>
    </div>
</div>

<h3>Medicines</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Medicine</th>
            <th>Dosage</th>
            <th>Frequency</th>
            <th>Duration</th>
            <th>Instructions</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.MedicineName</td>
            <td>@item.Dosage</td>
            <td>@item.Frequency</td>
            <td>@item.Duration</td>
            <td>
                @(item.Instructions ?? "None")
            </td>
        </tr>
    }
    </tbody>
</table>

    <div class="mt-3">
    <a asp-controller="Prescriptions"
       asp-action="DownloadPdf"
       asp-route-prescriptionId="@Model.Id"
       class="btn btn-danger">
        Download PDF
    </a>

    <a asp-controller="Appointments"
       asp-action="Details"
       asp-route-id="@Model.AppointmentId"
       class="btn btn-secondary">
        Back to Appointment
    </a>
</div>
